<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
    </startup>
	<connectionStrings>
		<add name="MasterDatabase" connectionString="Server=(localdb)\MSSQLLocalDB;Integrated security=True;database=master" providerName="System.Data.SqlClient" />
		<add name="TestDatabase" connectionString="Server=(localdb)\MSSQLLocalDB;Integrated security=True;database=test" providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>